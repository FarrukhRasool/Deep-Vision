      "source": [
        "# --- MODEL 3: ViT-B16 & DNN : Dropout   ---\n",
        "\n",
        "vit_base.trainable = False\n",
        "model_vit_DNN_BN_DO = tf.keras.Sequential()\n",
        "model_vit_DNN_BN_DO.add(tf.keras.layers.Input(shape=(IMG_SIZE, IMG_SIZE, 3)))\n",
        "model_vit_DNN_BN_DO.add(vit_base)\n",
        "model_vit_DNN_BN_DO.add(tf.keras.layers.Lambda(lambda x: x[:, 0, :]))\n",
        "\n",
        "model_vit_DNN_BN_DO.add(tf.keras.layers.Dense(512, use_bias = False))\n",
        "model_vit_DNN_BN_DO.add(tf.keras.layers.Activation('gelu'))\n",
        "model_vit_DNN_BN_DO.add(tf.keras.layers.Dropout(0.4))\n",
        "\n",
        "model_vit_DNN_BN_DO.add(tf.keras.layers.Dense(256, use_bias = False))\n",
        "model_vit_DNN_BN_DO.add(tf.keras.layers.Activation('gelu'))\n",
        "model_vit_DNN_BN_DO.add(tf.keras.layers.Dropout(0.3))\n",
        "\n",
        "model_vit_DNN_BN_DO.add(tf.keras.layers.Dense(NUM_CLASSES, activation='softmax'))\n",
        "\n",
        "model_vit_DNN_BN_DO.compile(\n",
        "    optimizer= tf.keras.optimizers.Adam(learning_rate=1e-4),\n",
        "    loss='sparse_categorical_crossentropy',\n",
        "    metrics=['accuracy']\n",
        ")\n",
        "model_vit_DNN_BN_DO.summary()"
      ]
    },
