      "source": [
        "# --- MODEL 2: ViT-B16 with head: Deep Neural Network  ---\n",
        "\n",
        "model_vit_DNN = tf.keras.Sequential()\n",
        "model_vit_DNN.add(tf.keras.layers.Input(shape=(IMG_SIZE, IMG_SIZE, 3)))\n",
        "model_vit_DNN.add(vit_base)\n",
        "model_vit_DNN.add(tf.keras.layers.Lambda(lambda x: x[:, 0, :]))\n",
        "\n",
        "\n",
        "model_vit_DNN.add(tf.keras.layers.Dense(512))\n",
        "model_vit_DNN.add(tf.keras.layers.Activation('gelu'))\n",
        "\n",
        "\n",
        "model_vit_DNN.add(tf.keras.layers.Dense(256))\n",
        "model_vit_DNN.add(tf.keras.layers.Activation('gelu'))\n",
        "\n",
        "model_vit_DNN.add(tf.keras.layers.Dense(NUM_CLASSES, activation='softmax'))\n",
        "\n",
        "model_vit_DNN.compile(\n",
        "    optimizer= tf.keras.optimizers.Adam(learning_rate=1e-4),  \n",
        "    loss='sparse_categorical_crossentropy',\n",
        "    metrics=['accuracy']\n",
        ")\n",
        "model_vit_DNN.summary()"
      ]
    },
