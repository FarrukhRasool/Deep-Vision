        "# --- MODEL 1: Vit-B16 base ---\n",
        "model_vit_base = tf.keras.Sequential()\n",
        "model_vit_base.add(tf.keras.layers.Input(shape=(IMG_SIZE, IMG_SIZE, 3)))\n",
