        "full_train_raw = full_train_raw.shuffle(15000, reshuffle_each_iteration=False)\n",
        "\n",
        "\n",
        "count = full_train_raw.reduce(tf.constant(0), lambda x, _: x + 1).numpy()\n",
        "print(\"Filtered dataset size:\", count)\n",
